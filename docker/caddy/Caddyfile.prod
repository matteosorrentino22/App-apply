{
	email {$CADDY_EMAIL}
}

{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy web:8000
	}
	handle /admin/* {
		reverse_proxy web:8000
	}
	handle /accounts/* {
		reverse_proxy web:8000
	}
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}
	# PWA statica (build di produzione): fallback su index.html per le rotte
	# client-side di React Router, coerente col resto servito da Caddy.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
