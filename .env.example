# Copia questo file in .env e personalizza i valori per lo sviluppo locale.
# Non committare mai il file .env reale.

# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,caddy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Path del Django Admin (Sprint 66), con la "/" finale. In produzione è letto
# anche da Caddy (docker-compose.prod.yml): un path non standard riduce i
# tentativi automatici di login. Default: admin/
DJANGO_ADMIN_PATH=admin/

# Registrazione su invito (Sprint 66): se valorizzato, la registrazione dalla
# PWA richiede questo codice; vuoto = registrazione aperta.
REGISTRATION_INVITE_CODE=

# Titolare del trattamento (Sprint 67), mostrato nelle pagine /privacy e
# /terms: dati reali solo nel .env, mai nel repository (pubblico). Se nome o
# email mancano le pagine mostrano l'avviso "dati del titolare da completare".
# L'indirizzo è facoltativo.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTROLLER_EMAIL=

# Email di servizio (Sprint 67): verifica dell'indirizzo, recupero password,
# conferma di cancellazione. Gmail SMTP con una "password per le app"
# dell'account Google (richiede la verifica in due passaggi). Vuote = nessuna
# email inviata (warning nei log), nuovi account già verificati, recupero
# password non disponibile. DEFAULT_FROM_EMAIL vuota = EMAIL_HOST_USER.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# URL pubblico della PWA usato nei link delle email; vuoto = https://$DOMAIN
# (in sviluppo, senza DOMAIN: http://localhost:5173).
PUBLIC_BASE_URL=

# PostgreSQL
POSTGRES_DB=app_apply
POSTGRES_USER=app_apply
POSTGRES_PASSWORD=app_apply
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Cache Django condivisa tra i worker (throttling, limite login admin, cache
# autocomplete città) — Sprint 66
REDIS_CACHE_URL=redis://redis:6379/2

# Google OAuth (django-allauth) — credenziali di test create sulla Google Cloud
# Console; lasciare vuoto in dev disabilita di fatto il login Google (nessun errore,
# semplicemente nessuna APP configurata per il provider). Dallo Sprint 67 il
# pulsante "Accedi con Google" compare solo se GOOGLE_OAUTH_CLIENT_ID è
# valorizzato; il flusso va però completato (sessione allauth -> token API)
# prima di attivarlo.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Claude via AWS Bedrock — scoring, generazione CV, parsing del CV caricato in
# onboarding (Docs/02-specifiche-tecniche-v5.md §3.5). Non l'API Anthropic diretta:
# le credenziali AWS sono lette automaticamente da boto3 dall'ambiente. Senza
# credenziali, l'endpoint di import CV fallisce solo se il testo estratto è
# sufficiente per chiamare Claude.
# Dallo Sprint 67 in UE, come dichiarato nell'informativa privacy: regione di
# Francoforte e profili di inferenza "eu." (instradamento solo verso regioni
# AWS dell'Unione Europea). I profili vanno abilitati nella console Bedrock
# della regione (Model access).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=eu-central-1
BEDROCK_CV_PARSING_MODEL=eu.anthropic.claude-opus-5
BEDROCK_SCORING_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_CV_GENERATION_MODEL=eu.anthropic.claude-opus-5

# Apify (fonte offerte LinkedIn, Docs/02-specifiche-tecniche-v5.md §5.3)
APIFY_API_TOKEN=

# Listino prezzi unitari per azioni oltre massimale (Docs/02-specifiche-tecniche-v5.md §4.6)
PRICE_MANUAL_CV_EXTRA=1.50
PRICE_IMPORT_EXTRA=0.50
PRICE_COVER_LETTER_EXTRA=1.50
PRICE_MANUAL_JOB_EXTRA=0.50
PRICE_REFERRAL_MESSAGE_EXTRA=1.00
PRICE_CV_DRAFT_CHAT_MESSAGE=0.20
PRICE_COVER_LETTER_DRAFT_CHAT_MESSAGE=0.20

# Notifiche Web Push (Docs/02-specifiche-tecniche-v5.md §3.8) — chiavi VAPID,
# generabili con `vapid --gen` (libreria py-vapid, dipendenza di pywebpush)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@example.com

# Deploy produzione (Sprint 21, Docs/02-specifiche-tecniche-v5.md §8) — usate solo
# da docker-compose.prod.yml, ignorate in sviluppo.
DOMAIN=
CADDY_EMAIL=

# Backup giornaliero (§8.4): storage a oggetti compatibile S3 esterno al VPS
# (es. Hetzner Object Storage, Backblaze B2). Se vuoto (Sprint 67) il backup
# è locale: dump DB + archivio media nel volume `local_backups`
# (/app/backups), conservati 7 giorni. BACKUP_LOCAL_DIR cambia solo la cartella.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
BACKUP_LOCAL_DIR=/app/backups
