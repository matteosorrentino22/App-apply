# Copia questo file in .env e personalizza i valori per lo sviluppo locale.
# Non committare mai il file .env reale.

# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,caddy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL
POSTGRES_DB=app_apply
POSTGRES_USER=app_apply
POSTGRES_PASSWORD=app_apply
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Google OAuth (django-allauth) — credenziali di test create sulla Google Cloud
# Console; lasciare vuoto in dev disabilita di fatto il login Google (nessun errore,
# semplicemente nessuna APP configurata per il provider).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# API Anthropic (Claude) — scoring, generazione CV, parsing del CV caricato in
# onboarding (02-specifiche-tecniche-v3.md §3.5). Senza chiave, l'endpoint di
# import CV fallisce solo se il testo estratto è sufficiente per chiamare Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_CV_PARSING_MODEL=claude-opus-5

# Apify (fonte offerte LinkedIn, 02-specifiche-tecniche-v3.md §5.3)
APIFY_API_TOKEN=
